---
import RecipeCard from '../components/RecipeCard.astro'
import Error from '../components/Error.astro'
import Header from '../components/Header.astro'
import { getFavorites } from '../lib/recipes'

export const prerender = false

const token = Astro.cookies.get('auth_token')?.value
const username = Astro.cookies.get('username')?.value
let error: string | null = null
let favoriteRecipes: any[] = []

if (!token || !username) {
  error = 'You need to be logged in to see your favorite recipes.'
} else {
  try {
    favoriteRecipes = await getFavorites(username, token)
  } catch (e) {
    if (e instanceof Error && e.message === 'Unauthorized') {
      Astro.cookies.delete('auth_token', { path: '/' })
      Astro.cookies.delete('username', { path: '/' })
      return Astro.redirect('/login')
    }
    console.error(e)
    error = 'Error while getting your favorite recipes'
  }
}
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My favorites - ZetaCooking</title>
    <style>
      body {
        font-family: system-ui, sans-serif;
        margin: 20px;
        background: white;
        color: #111827;
      }
      h1 {
        margin-bottom: 1rem;
      }
      .favorites-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1.5rem;
      }
    </style>
  </head>
  <body>
    <Header />

    <h1>My favorites</h1>

    {
      error ? (
        <Error error={error} />
      ) : favoriteRecipes.length > 0 ? (
        <div class="favorites-grid">
          {favoriteRecipes.map((recipe) => (
            <RecipeCard
              title={recipe.recipe.name}
              image_url={recipe.recipe.image_url}
              name={recipe.recipe.name}
              description={recipe.recipe.description}
              id={recipe.recipe.id}
              when_to_eat={recipe.recipe.when_to_eat}
            />
          ))}
        </div>
      ) : (
        <p>You don't have any favorite recipe yet.</p>
      )
    }
  </body>
</html>
