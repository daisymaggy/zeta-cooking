---
export const prerender = false
import Error from "../../components/Error.astro";
import RecipeCard from "../../components/RecipeCard.astro";
import type { Recipe } from "../../types/recipe";
import Header from "../../components/Header.astro";
import { getRecipeById, getRelatedRecipes, getFavorites } from "../../lib/recipes";

const { id } = Astro.params;

const token = Astro.cookies.get("auth_token")?.value;
const username = Astro.cookies.get("username")?.value ?? null;
const isLoggedIn = !!token;

let recipeData: Recipe | null = null;
let error: string | null = null;
let relatedRecipesData: Recipe[] = [];
let isFavorited = false;

if (!id) {
  error = "Recipe ID is missing";
} else {
  try {
    recipeData = await getRecipeById(id);
    relatedRecipesData = await getRelatedRecipes(id);
    
    if (isLoggedIn && token && username) {
      try {
        const favorites = await getFavorites(username, token);
        isFavorited = favorites.some(fav => String(fav.recipe.id) === String(id));
      } catch (e) {
        // silent
      }
    }
  } catch (e) {
    error = "Error loading the recipe";
  }
}
