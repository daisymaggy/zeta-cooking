---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{recipeData?.name || 'Recette'}</title>
    <style>
        body {
            font-family: system-ui, sans-serif;
            margin: 20px;
        }
        .content {
            display: flex;
            justify-content: center;
            gap: 10rem;
        }
        .recipe-header {
            margin-bottom: 2rem;
        }
        .recipe-title {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 0.5rem;
        }

        .favorite-btn {
            background: none;
            border: none;
            cursor: pointer;
            padding: 0;
            display: flex;
            align-items: center;
            color: #999; /* couleur du cœur */
            transition: transform 0.2s;
        }

        .favorite-btn:hover {
            transform: scale(1.1);
        }
        .recipe-image {
            width: 100%;
            max-height: 400px;
            object-fit: cover;
            border-radius: 8px;
        }
        .recipe-meta {
            display: flex;
            gap: 2rem;
            margin: 1rem 0;
            color: #666;
        }
        .recipe-section {
            margin: 2rem 0;
        }
        .related-recipes {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }
    </style>
</head>
<body>
    <Header />

    <div class="content">
        {error ? (
            <Error error={error}/>
        ) : recipeData ? (
            <div>
                <div class="recipe-header">
                    <div class="recipe-title">
                        <h1>{recipeData.name}</h1>
                        <button class="favorite-btn" 
                            data-logged-in={isLoggedIn ? "true" : "false"}
                            data-username={username}
                            data-id={id}
                            data-favorited={isFavorited ? "true" : "false"}
                            title="Ajouter aux favoris">
                            <svg 
                                xmlns="http://www.w3.org/2000/svg" 
                                width="32" 
                                height="32" 
                                viewBox="0 0 24 24" 
                                fill="none" 
                                stroke="currentColor" 
                                stroke-width="2" 
                                stroke-linecap="round" 
                                stroke-linejoin="round"
                            >
                                <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
                            </svg>
                        </button>

                    </div>
                        <p style="text-transform:uppercase">{recipeData.when_to_eat}</p>
                    {recipeData.image_url && (
                        <img 
                            src={recipeData.image_url} 
                            alt={recipeData.name}
                            class="recipe-image"
                        />
                    )}                
                    <p style="font-style: italic">{recipeData.description}</p>
                </div>

                <div class="recipe-meta">
                    <div>⏱️ Preparation : {recipeData.prep_time} min</div>
                    <div>🍳 Cooking Time : {recipeData.cook_time} min</div>
                    <div>🍽️ Servings : {recipeData.servings}</div>
                    <div>🔥 Calories : {recipeData.calories} kcal</div>
                </div>

                <div class="recipe-section">
                    <h2>Instructions</h2>
                    <p style="white-space: pre-wrap;">{recipeData.instructions}</p>
                </div>

                {recipeData.disclaimer && (
                    <div class="recipe-section">
                        <p><em>{recipeData.disclaimer}</em></p>
                    </div>
                )}

                <div class="recipe-section" style="color: #999; font-size: 0.9em;">
                    <p style="font-style: italic">by {recipeData.created_by}</p>
                    <p>{new Date(recipeData.created_at).toLocaleDateString('fr-FR')}</p>
                </div>
            </div>
            <div>
                <h1>Related Recipes</h1>
                {relatedRecipesData.length > 0 ? (
                    <div class="related-recipes">
                        {relatedRecipesData.map((recipe) => (
                                <RecipeCard 
                                    title={recipe.name}
                                    image_url={recipe.image_url}
                                    name={recipe.name}
                                    description={recipe.description}
                                    id={recipe.id}
                                    when_to_eat={recipe.when_to_eat}
                                />
                        ))}
                    </div>
                ) : (
                    <p>No related recipes.</p>
                )}
            </div>
        ) : (
            <p>Loading...</p>
        )}
    </div>
    <script type="module">
        document.addEventListener("DOMContentLoaded", async () => {
        const favBtn = document.querySelector(".favorite-btn");
        if (!favBtn) return;

        const id = favBtn.dataset.id;

        const setUI = (favorited) => {
            favBtn.dataset.favorited = favorited ? "true" : "false";
            favBtn.style.color = favorited ? "red" : "#999";
        };

        const setLoggedOutUI = () => {
            favBtn.dataset.loggedIn = "false";
            favBtn.style.opacity = "0.4";
            favBtn.style.cursor = "not-allowed";
            favBtn.title = "Login required";
            favBtn.removeEventListener("click", toggleFavorite);
            favBtn.addEventListener("click", () => {
                window.location.href = "/login";
            });
        };

        const toggleFavorite = async () => {
            const favorited = favBtn.dataset.favorited === "true";

            try {
                const res = await fetch(
                    favorited
                        ? "/api/favorites/removeFavorite.json"
                        : "/api/favorites/addFavorite.json",
                    {
                        method: favorited ? "DELETE" : "POST",
                        headers: { "Content-Type": "application/json" },
                        credentials: "same-origin",
                        body: JSON.stringify({ id }),
                    }
                );

                if (res.status === 401) {
                    alert("Your session has expired. Please log in again.");
                    window.location.href = "/logout";
                    return;
                }

                if (!res.ok) {
                    console.error("Failed to toggle favorite");
                    return;
                }

                setUI(!favorited);
            } catch (err) {
                console.error(err);
            }
        };

        const isLoggedIn = favBtn.dataset.loggedIn === "true";

        if (!isLoggedIn) {
            setLoggedOutUI();
            return;
        }

        const initialFavorited = favBtn.dataset.favorited === "true";
        setUI(initialFavorited);

        favBtn.addEventListener("click", toggleFavorite);
    });

    </script>


</body>
</html>