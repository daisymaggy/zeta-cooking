---
import RecipeCard from "../components/RecipeCard.astro";
import Error from "../components/Error.astro";
import type { Recipe } from "../types/recipe";
import Header from "../components/Header.astro";

export const prerender = false;

const searchQuery = Astro.url.searchParams.get('q') || '';

let error: string | null = null;
let allRecipesData: Recipe[] = [];

try {
    const url = searchQuery
        ? `https://gourmet.cours.quimerch.com/search?q=${encodeURIComponent(searchQuery)}`
        : `https://gourmet.cours.quimerch.com/recipes`;

    const response = await fetch(url, {
        method: "GET",
        headers: {
            'Accept': 'application/json'
        }
    });

    if (response.ok) {
        allRecipesData = await response.json();
    } else {
        const errorData = await response.json();
        error = errorData.error || "Recipes not found";
    }
} catch (e) {
    error = "Error loading the recipes";
    console.error(e);
}
---

<html lang="en">
<head>
	<meta charset="utf-8" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<meta name="viewport" content="width=device-width" />
	<meta name="generator" content={Astro.generator} />
	<title>ZetaCooking - {searchQuery ? `Search: ${searchQuery}` : 'All Recipes'}</title>
	<style>
		:root {
			--muted: #6b7280;
			--accent: #fb923c;
		}
		* { box-sizing: border-box; }
		body {
			font-family: system-ui, sans-serif;
			margin: 20px;
			background: white;
			color: #111827;
		}
		.hero-wrapper {
			position: relative;
			display: block;
			height: 33vh;
			max-height: 360px;
			overflow: hidden;
			border-radius: 12px;
		}
		.hero-image {
			width: 100%;
			height: 100%;
			display: block;
			object-fit: cover;
			object-position: top;
			border-radius: 0;
		}
		.hero-title {
			position: absolute;
			left: 50%;
			top: 50%;
			transform: translate(-50%, -50%);
			background: rgba(0, 0, 0, 0.35);
			backdrop-filter: blur(6px);
			-webkit-backdrop-filter: blur(6px);
			padding: 12px 20px;
			border-radius: 10px;
			color: #fff;
			font-weight: 700;
			font-style: italic;
			font-size: 34px;
			box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
			border: 1px solid rgba(255, 255, 255, 0.06);
		}
		.all-recipes {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
			gap: 1.5rem;
			width: 100%;
		}
		.search-info {
			margin: 20px 0;
			padding: 12px 16px;
			background: #f3f4f6;
			border-left: 4px solid var(--accent);
			border-radius: 8px;
			display: flex;
			justify-content: space-between;
			align-items: center;
		}
		.search-info a {
			color: var(--accent);
			text-decoration: none;
			font-weight: 600;
		}
		.search-info a:hover { text-decoration: underline; }
		.recipe-card {
			transition: opacity 0.2s ease;
		}
		@media (max-width: 720px) {
			.topbar {
				flex-direction: column;
				align-items: stretch;
			}
			.search {
				order: 2;
				width: 100%;
				margin: 8px 0;
			}
			.login {
				order: 3;
				align-self: flex-end;
			}
			.hero-title { font-size: 22px; padding: 10px 14px; }
		}
	</style>
</head>
<body>
	<Header />

	<div class="hero-wrapper">
		<img class="hero-image" src="/images/cuisine.jpeg" alt="cuisine" />
		<div class="hero-title">ZetaCooking</div>
	</div>

	{searchQuery && allRecipesData.length > 0 && (
		<div class="search-info">
			<span>🔍 Search results for: <strong>"{searchQuery}"</strong> ({allRecipesData.length} recipe{allRecipesData.length !== 1 ? 's' : ''} found)</span>
			<a href="/">Clear search</a>
		</div>
	)}

	{error ? (
		<Error error={error} />
	) : allRecipesData.length > 0 ? (
		<div>
			<h1 id="pageTitle">All Recipes</h1>
			<div class="all-recipes">
				{allRecipesData.map(recipe => (
					<RecipeCard
						title={recipe.name}
						image_url={recipe.image_url}
						name={recipe.name}
						description={recipe.description}
						id={recipe.id}
						when_to_eat={recipe.when_to_eat}
					/>
				))}
			</div>
		</div>
	) : (
		<p style="margin-top: 20px;">No recipes found{searchQuery ? ` for "${searchQuery}"` : ''}.</p>
	)}
</body>
</html>