---
import RecipeCard from "../components/RecipeCard.astro";
import Error from "../components/Error.astro";
import type { Recipe } from "../types/recipe";
import Header from "../components/Header.astro";

const searchQuery = Astro.url.searchParams.get('q') || '';

let error: string | null = null;
let allRecipesData: Recipe[] = [];
try {
	const response = await fetch(
		`${Astro.url.origin}/api/all_recipes/all.json`,
	);
	if (response.ok) {
		allRecipesData = await response.json();
	} else {
		const errorData = await response.json();
		error = errorData.error || "Recipes not found";
	}
} catch (e) {
	error = "Error loading the recipes";
	console.error(e);
}
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<style>
			:root {
				--muted: #6b7280;
				--accent: #fb923c;
			}
			* {
				box-sizing: border-box;
			}
			body {
				font-family: system-ui, sans-serif;
				margin: 20px;
				background: white;
				color: #111827;
			}
			.hero-wrapper {
				position: relative;
				display: block;
				height: 33vh;
				max-height: 360px;
				overflow: hidden;
				border-radius: 12px;
			}
			.hero-image {
				width: 100%;
				height: 100%;
				display: block;
				object-fit: cover;
				object-position: top;
				border-radius: 0;
			}
			.hero-title {
				position: absolute;
				left: 50%;
				top: 50%;
				transform: translate(-50%, -50%);
				background: rgba(0, 0, 0, 0.35);
				backdrop-filter: blur(6px);
				-webkit-backdrop-filter: blur(6px);
				padding: 12px 20px;
				border-radius: 10px;
				color: #fff;
				font-weight: 700;
				font-style: italic;
				font-size: 34px;
				box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
				border: 1px solid rgba(255, 255, 255, 0.06);
			}
			.all-recipes {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
				gap: 1.5rem;
				width: 100%;
			}
			.search-info {
				margin: 20px 0;
				padding: 12px 16px;
				background: #f3f4f6;
				border-left: 4px solid var(--accent);
				border-radius: 8px;
				display: flex;
				justify-content: space-between;
				align-items: center;
			}
			.search-info a {
				color: var(--accent);
				text-decoration: none;
				font-weight: 600;
			}
			.search-info a:hover {
				text-decoration: underline;
			}
			.recipe-card {
				transition: opacity 0.2s ease;
			}
			.recipe-card.hidden {
				display: none;
			}
			@media (max-width: 720px) {
				.topbar {
					flex-direction: column;
					align-items: stretch;
				}
				.search {
					order: 2;
					width: 100%;
					margin: 8px 0;
				}
				.login {
					order: 3;
					align-self: flex-end;
				}
				.hero-title {
					font-size: 22px;
					padding: 10px 14px;
				}
			}
		</style>
		<meta name="generator" content={Astro.generator} />
		<title>ZetaCooking - {searchQuery ? `Search: ${searchQuery}` : 'All Recipes'}</title>
	</head>
	<body>
		<Header />

		<div class="hero-wrapper">
			<img class="hero-image" src="/images/cuisine.jpeg" alt="cuisine" />
			<div class="hero-title">ZetaCooking</div>
		</div>
		
		<div class="search-info" id="searchInfo" style="display: none;">
			<span id="searchText"></span>
			<a href="/">Clear search</a>
		</div>
		
		{
			error ? (
				<Error error={error} />
			) : allRecipesData ? (
				<div>
					<h1 id="pageTitle">All Recipes</h1>
					{allRecipesData.length > 0 ? (
						<div class="all-recipes" id="recipesGrid">
							{allRecipesData.map((recipe) => (
								<div class="recipe-card" data-recipe-name={recipe.name.toLowerCase()}>
									<RecipeCard
										title={recipe.name}
										image_url={recipe.image_url}
										name={recipe.name}
										description={recipe.description}
										id={recipe.id}
										when_to_eat={recipe.when_to_eat}
									/>
								</div>
							))}
						</div>
						<p id="noResults" style="display: none;">No recipes found.</p>
					) : (
						<p>No recipes found.</p>
					)}
				</div>
			) : (
				<p>Loading...</p>
			)
		}
		
		<script>
			function filterRecipes() {
				const urlParams = new URLSearchParams(window.location.search);
				const query = urlParams.get('q');
				
				const searchInput = document.getElementById('searchInput') as HTMLInputElement;
				const searchInfo = document.getElementById('searchInfo') as HTMLDivElement;
				const searchText = document.getElementById('searchText') as HTMLSpanElement;
				const pageTitle = document.getElementById('pageTitle') as HTMLHeadingElement;
				const recipeCards = document.querySelectorAll('.recipe-card');
				const noResults = document.getElementById('noResults') as HTMLParagraphElement;
				
				if (query && query.trim()) {
					const searchTerm = query.toLowerCase().trim();

					if (searchInput) {
						searchInput.value = query;
					}
					
					let visibleCount = 0;
					recipeCards.forEach((card) => {
						const recipeName = (card as HTMLElement).dataset.recipeName || '';
						if (recipeName.includes(searchTerm)) {
							card.classList.remove('hidden');
							visibleCount++;
						} else {
							card.classList.add('hidden');
						}
					});
					
					if (searchInfo && searchText) {
						searchInfo.style.display = 'flex';
						searchText.innerHTML = `🔍 Search results for: <strong>"${query}"</strong> (${visibleCount} recipe${visibleCount !== 1 ? 's' : ''} found)`;
					}
					
					if (pageTitle) {
						pageTitle.textContent = 'Search Results';
					}
					
					if (noResults) {
						noResults.style.display = visibleCount === 0 ? 'block' : 'none';
						if (visibleCount === 0) {
							noResults.textContent = `No recipes found for "${query}".`;
						}
					}
				} else {
					recipeCards.forEach((card) => {
						card.classList.remove('hidden');
					});
					
					if (searchInfo) {
						searchInfo.style.display = 'none';
					}
					
					if (noResults) {
						noResults.style.display = 'none';
					}
				}
			}

			filterRecipes();
		</script>
	</body>
</html>